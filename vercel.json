{
  "version": 2,
  "builds": [
    { "src": "notaplus.html", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/img/(.*)", "dest": "/public/img/$1" },
    { "src": "/", "dest": "/notaplus.html" },
    { "src": "/(.*)", "dest": "/notaplus.html" }
  ]
}
